{
  "name": "manibase Infotermin – 2 Anmeldung Confirm (DOI)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "manibase-confirm", "responseMode": "responseNode", "options": {} },
      "id": "wf2-webhook",
      "name": "Webhook Confirm",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 320]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.headers['x-manibase-secret'] }}", "rightValue": "{{CONFIG:SHARED_SECRET}}", "operator": { "type": "string", "operation": "equals" } } ] }
      },
      "id": "wf2-if-secret",
      "name": "IF Secret ok (X-Manibase-Secret)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 320]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 401, "responseBody": "={ \"ok\": false }" },
      "id": "wf2-resp-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [520, 560]
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst token=String(($json.body||{}).token||'');\nreturn [{ json: { token_digest: crypto.createHash('sha256').update(token).digest('hex') } }];"
      },
      "id": "wf2-code-digest",
      "name": "SHA-256(token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"search_read\",[[[\"token_digest\",\"=\",\"{{ $json.token_digest }}\"]]],{\"fields\":[\"id\",\"status\",\"termin\",\"email_norm\"]}]] } }",
        "options": {}
      },
      "id": "wf2-odoo-find",
      "name": "Odoo search_read reg by token_digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 320]
    },
    {
      "parameters": {
        "jsCode": "// JSON-RPC-Result auspacken + Ablauf/TTL prüfen (Termin in der Zukunft?).\nconst rows = ($json.result)||[];\nif (rows.length === 0) return [{ json: { outcome: 'not_found' } }];\nconst r = rows[0];\nconst expired = new Date(r.termin).getTime() < Date.now();\nif (r.status === 'confirmed') return [{ json: { outcome: 'already', reg_id: r.id } }];\nif (expired) return [{ json: { outcome: 'expired', reg_id: r.id } }];\nreturn [{ json: { outcome: 'received', reg_id: r.id, termin: r.termin, email_norm: r.email_norm } }];"
      },
      "id": "wf2-map",
      "name": "Result auspacken + TTL (found/status/termin)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 320]
    },
    {
      "parameters": {
        "rules": { "values": [
          { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.outcome }}", "rightValue": "not_found", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "gone" },
          { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.outcome }}", "rightValue": "expired", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "expired" },
          { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.outcome }}", "rightValue": "already", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "already" }
        ] },
        "fallbackOutput": "extra"
      },
      "id": "wf2-switch",
      "name": "Switch (gone | expired | already | received)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1120, 320]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 410, "responseBody": "={ \"ok\": false, \"error\": \"gone\" }" },
      "id": "wf2-resp-410",
      "name": "Respond 410 (nicht gefunden ODER abgelaufen)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1360, 140]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 409, "responseBody": "={ \"ok\": false, \"error\": \"already_confirmed\" }" },
      "id": "wf2-resp-409",
      "name": "Respond 409 (bereits bestätigt / Claim verloren)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"create\",[{\"mail_key\":\"invite:{{ $json.reg_id }}\",\"reg_id\":{{ $json.reg_id }},\"state\":\"sending\"}]] } }",
        "options": {}
      },
      "id": "wf2-outbox-invite",
      "name": "Claim outbox mail_key invite (unique = CAS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1360, 480]
    },
    {
      "parameters": {
        "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.error !== undefined }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] }
      },
      "id": "wf2-if-claim",
      "name": "IF Claim-Konflikt (Read-after-Conflict -> 409)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"write\",[[{{ $('Result auspacken + TTL (found/status/termin)').item.json.reg_id }}],{\"status\":\"confirmed\"}]] } }",
        "options": {}
      },
      "id": "wf2-write-confirmed",
      "name": "Odoo write status=confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1760, 560]
    },
    {
      "parameters": {
        "jsCode": "// ICS (Europe/Berlin), Empfänger + Termin durchreichen, 60 min Dauer.\nconst m = $('Result auspacken + TTL (found/status/termin)').item.json;\nconst dt = new Date(m.termin);\nconst y=dt.getFullYear(); const pad=n=>String(n).padStart(2,'0');\nconst start = `${y}${pad(dt.getMonth()+1)}${pad(dt.getDate())}T${pad(dt.getHours())}${pad(dt.getMinutes())}00`;\nconst endDt = new Date(dt.getTime()+60*60000);\nconst end = `${endDt.getFullYear()}${pad(endDt.getMonth()+1)}${pad(endDt.getDate())}T${pad(endDt.getHours())}${pad(endDt.getMinutes())}00`;\nconst teams = new Date(m.termin).getDate() <= 29 ? '{{CONFIG:TEAMS_LINK_T1}}' : '{{CONFIG:TEAMS_LINK_T2}}';\nconst ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//manibase//Infotermin//DE','METHOD:REQUEST','BEGIN:VTIMEZONE','TZID:Europe/Berlin','END:VTIMEZONE','BEGIN:VEVENT','UID:'+m.reg_id+'@manibase.de','DTSTAMP:20260720T000000Z','SEQUENCE:0','DTSTART;TZID=Europe/Berlin:'+start,'DTEND;TZID=Europe/Berlin:'+end,'SUMMARY:manibase Infotermin','ORGANIZER:mailto:{{CONFIG:SENDER}}','END:VEVENT','END:VCALENDAR'].join('\\r\\n');\nreturn [{ json: { ics_base64: Buffer.from(ics).toString('base64'), email_norm: m.email_norm, teams } }];"
      },
      "id": "wf2-code-ics",
      "name": "Build ICS (TZID=Europe/Berlin, UID, SEQUENCE, 60min)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1960, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"message\": { \"subject\": \"Ihre Einladung zum Infotermin\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Einwahl: <a href='{{ $json.teams }}'>Teams</a></p>\" }, \"attachments\": [{ \"@odata.type\": \"#microsoft.graph.fileAttachment\", \"name\": \"termin.ics\", \"contentType\": \"text/calendar\", \"contentBytes\": \"{{ $json.ics_base64 }}\" }], \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $json.email_norm }}\" } }] } }",
        "options": {}
      },
      "id": "wf2-graph-invite",
      "name": "Graph sendMail Einladung + ICS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2160, 560],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"search\",[[[\"mail_key\",\"=\",\"invite:{{ $('Result auspacken + TTL (found/status/termin)').item.json.reg_id }}\"]]]]] } }",
        "options": {}
      },
      "id": "wf2-outbox-sent",
      "name": "Odoo write outbox invite state=sent (Fehler: failed_unknown)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2360, 560]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 200, "responseBody": "={ \"ok\": true }" },
      "id": "wf2-resp-200",
      "name": "Respond 200 (bestätigt)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2560, 560]
    }
  ],
  "connections": {
