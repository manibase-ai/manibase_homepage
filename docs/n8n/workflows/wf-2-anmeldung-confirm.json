{
  "name": "manibase Infotermin – 2 Anmeldung Confirm (DOI)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "manibase-confirm", "responseMode": "responseNode", "options": {} },
      "id": "wf2-webhook",
      "name": "Webhook Confirm",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.headers['x-manibase-secret'] }}", "rightValue": "{{CONFIG:SHARED_SECRET}}", "operator": { "type": "string", "operation": "equals" } } ] }
      },
      "id": "wf2-if-secret",
      "name": "IF Secret ok (X-Manibase-Secret)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 401, "responseBody": "={ \"ok\": false }" },
      "id": "wf2-resp-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [640, 520]
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst token=String(($json.body||{}).token||'');\nconst digest=crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json: { token_digest: digest } }];"
      },
      "id": "wf2-code-digest",
      "name": "SHA-256(token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"search_read\",[[[\"token_digest\",\"=\",\"{{ $json.token_digest }}\"]]],{\"fields\":[\"id\",\"status\",\"termin\"]}]] } }",
        "options": {}
      },
      "id": "wf2-odoo-find",
      "name": "Odoo search_read reg by token_digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [860, 300]
    },
    {
      "parameters": {
        "rules": { "values": [
          { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.found }}", "rightValue": false, "operator": { "type": "boolean", "operation": "false" } } ] }, "outputKey": "not_found_or_expired" },
          { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.status }}", "rightValue": "confirmed", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "already_confirmed" }
        ] },
        "fallbackOutput": "extra"
      },
      "id": "wf2-switch",
      "name": "Switch (nicht gefunden/abgelaufen | confirmed | received)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1080, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 410, "responseBody": "={ \"ok\": false, \"error\": \"gone\" }" },
      "id": "wf2-resp-410",
      "name": "Respond 410 (nicht gefunden ODER abgelaufen)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1320, 180]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 409, "responseBody": "={ \"ok\": false, \"error\": \"already_confirmed\" }" },
      "id": "wf2-resp-409",
      "name": "Respond 409 (bereits bestätigt / Claim verloren)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"create\",[{\"mail_key\":\"invite:{{ $json.reg_id }}\",\"reg_id\":{{ $json.reg_id }},\"state\":\"sending\"}]] } }",
        "options": {}
      },
      "id": "wf2-outbox-invite",
      "name": "Claim outbox mail_key invite (unique = CAS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1320, 420],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// ICS bauen (Europe/Berlin). Bei Unique-Violation stattdessen Read-after-Conflict\n// (Zustand lesen: confirmed->409, received-haengt->weitertreiben->200).\nconst reg = $json.reg_id;\nconst dtstart = ($json.termin_ics)||'20260729T193000';\nconst ics = ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//manibase//Infotermin//DE','METHOD:REQUEST','BEGIN:VTIMEZONE','TZID:Europe/Berlin','END:VTIMEZONE','BEGIN:VEVENT','UID:'+reg+'@manibase.de','DTSTAMP:20260720T000000Z','SEQUENCE:0','DTSTART;TZID=Europe/Berlin:'+dtstart,'DTEND;TZID=Europe/Berlin:'+dtstart,'SUMMARY:manibase Infotermin','ORGANIZER:mailto:{{CONFIG:SENDER}}','END:VEVENT','END:VCALENDAR'].join('\\r\\n');\nreturn [{ json: { ics_base64: Buffer.from(ics).toString('base64') } }];"
      },
      "id": "wf2-code-ics",
      "name": "Build ICS (TZID=Europe/Berlin, UID, SEQUENCE)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"message\": { \"subject\": \"Ihre Einladung zum Infotermin\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Einwahl: <a href='{{CONFIG:TEAMS_LINK_T1}}'>Teams (Termin 1)</a> / <a href='{{CONFIG:TEAMS_LINK_T2}}'>Teams (Termin 2)</a></p>\" }, \"attachments\": [{ \"@odata.type\": \"#microsoft.graph.fileAttachment\", \"name\": \"termin.ics\", \"contentType\": \"text/calendar\", \"contentBytes\": \"{{ $json.ics_base64 }}\" }], \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $json.email_norm }}\" } }] } }",
        "options": {}
      },
      "id": "wf2-graph-invite",
      "name": "Graph sendMail Einladung + ICS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1760, 420],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// outbox invite -> sent. Graph-Fehler -> state=failed_unknown (Reconciliation).\nreturn [{ json: { outbox_state: 'sent' } }];"
      },
      "id": "wf2-outbox-sent",
      "name": "outbox invite state=sent (sonst failed_unknown)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 420]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 200, "responseBody": "={ \"ok\": true }" },
      "id": "wf2-resp-200",
      "name": "Respond 200 (bestätigt)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2200, 420]
    }
  ],
  "connections": {
    "Webhook Confirm": { "main": [[{ "node": "IF Secret ok (X-Manibase-Secret)", "type": "main", "index": 0 }]] },
    "IF Secret ok (X-Manibase-Secret)": { "main": [[{ "node": "SHA-256(token)", "type": "main", "index": 0 }], [{ "node": "Respond 401", "type": "main", "index": 0 }]] },
    "SHA-256(token)": { "main": [[{ "node": "Odoo search_read reg by token_digest", "type": "main", "index": 0 }]] },
    "Odoo search_read reg by token_digest": { "main": [[{ "node": "Switch (nicht gefunden/abgelaufen | confirmed | received)", "type": "main", "index": 0 }]] },
    "Switch (nicht gefunden/abgelaufen | confirmed | received)": { "main": [[{ "node": "Respond 410 (nicht gefunden ODER abgelaufen)", "type": "main", "index": 0 }], [{ "node": "Respond 409 (bereits bestätigt / Claim verloren)", "type": "main", "index": 0 }], [{ "node": "Claim outbox mail_key invite (unique = CAS)", "type": "main", "index": 0 }]] },
    "Claim outbox mail_key invite (unique = CAS)": { "main": [[{ "node": "Build ICS (TZID=Europe/Berlin, UID, SEQUENCE)", "type": "main", "index": 0 }], [{ "node": "Respond 409 (bereits bestätigt / Claim verloren)", "type": "main", "index": 0 }]] },
    "Build ICS (TZID=Europe/Berlin, UID, SEQUENCE)": { "main": [[{ "node": "Graph sendMail Einladung + ICS", "type": "main", "index": 0 }]] },
    "Graph sendMail Einladung + ICS": { "main": [[{ "node": "outbox invite state=sent (sonst failed_unknown)", "type": "main", "index": 0 }]] },
    "outbox invite state=sent (sonst failed_unknown)": { "main": [[{ "node": "Respond 200 (bestätigt)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
