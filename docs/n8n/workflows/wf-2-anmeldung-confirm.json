    {
      "parameters": { "jsCode": "// ICS Europe/Berlin (Luxon), vollständige VTIMEZONE, Teams-Link als\n// LOCATION/URL/DESCRIPTION (RFC-5545-escaped). Bezug outbox mail_key invite.\nconst m=$('Dedup-Entscheidung').item.json;\nconst esc=s=>String(s||'').replace(/\\\\/g,'\\\\\\\\').replace(/;/g,'\\\\;').replace(/,/g,'\\\\,').replace(/\\r?\\n/g,'\\\\n');\nconst start=DateTime.fromISO(m.termin,{setZone:true}).setZone('Europe/Berlin');\nconst end=start.plus({minutes:60});\nconst f=dt=>dt.toFormat(\"yyyyLLdd'T'HHmmss\");\nconst teams=start.day<=29?'{{CONFIG:TEAMS_LINK_T1}}':'{{CONFIG:TEAMS_LINK_T2}}';\nconst L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//manibase//Infotermin//DE','CALSCALE:GREGORIAN','METHOD:REQUEST','BEGIN:VTIMEZONE','TZID:Europe/Berlin','BEGIN:DAYLIGHT','TZOFFSETFROM:+0100','TZOFFSETTO:+0200','TZNAME:CEST','DTSTART:19700329T020000','RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU','END:DAYLIGHT','BEGIN:STANDARD','TZOFFSETFROM:+0200','TZOFFSETTO:+0100','TZNAME:CET','DTSTART:19701025T030000','RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU','END:STANDARD','END:VTIMEZONE','BEGIN:VEVENT','UID:'+m.reg_id+'@manibase.de','DTSTAMP:'+DateTime.utc().toFormat(\"yyyyLLdd'T'HHmmss'Z'\"),'SEQUENCE:0','DTSTART;TZID=Europe/Berlin:'+f(start),'DTEND;TZID=Europe/Berlin:'+f(end),'SUMMARY:manibase Infotermin','LOCATION:'+esc(teams),'URL:'+esc(teams),'DESCRIPTION:'+esc('Einwahl (MS Teams): '+teams),'ORGANIZER:mailto:{{CONFIG:SENDER}}','END:VEVENT','END:VCALENDAR'];\nconst fold=l=>{if(Buffer.byteLength(l,'utf8')<=75)return l;let out='',cur='',first=true;for(const ch of l){const lim=first?75:74;if(Buffer.byteLength(cur+ch,'utf8')>lim){out+=(first?'':'\\r\\n ')+cur;first=false;cur=ch;}else cur+=ch;}return out+(first?'':'\\r\\n ')+cur;};\nconst ics=L.map(fold).join('\\r\\n');\nreturn [{ json:{ ics_base64:Buffer.from(ics).toString('base64'), email_norm:m.email_norm, teams, reg_id:m.reg_id, name:m.name, unternehmen:m.unternehmen, termin:m.termin } }];" },
      "id": "wf2-ics", "name": "Build ICS (Europe/Berlin, VTIMEZONE, LOCATION/URL/DESCRIPTION)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2820, 300]
