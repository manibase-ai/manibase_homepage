        "options": {} },
      "id": "wf2-outbox-invite", "name": "Claim outbox mail_key invite (unique = CAS)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1340, 560]
    },
    {
      "parameters": { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.error !== undefined }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] } },
      "id": "wf2-if-claim", "name": "IF Claim-Konflikt?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 560]
    },
    {
      "parameters": { "jsCode": "// Read-after-Conflict: bestehenden reg-Status lesen (aus dem Map-Node).\n// received (Pre-Send-Crash) -> weitertreiben (200), confirmed -> 409.\n// Hier: der invite-Claim existierte schon; ein früherer Lauf hängt bei received\n// -> wir treiben weiter. (Konservativ: 200 nach Sicherstellen von confirmed+Versand.)\nreturn [{ json: { resume: true } }];" },
      "id": "wf2-claim-recover", "name": "Claim-Konflikt: Read-after-Conflict (resume)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1540, 760]
