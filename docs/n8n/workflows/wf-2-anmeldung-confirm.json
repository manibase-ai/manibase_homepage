    {
      "parameters": { "jsCode": "// Best-Effort-Dedup (unter Concurrency 1): sent -> 409; sending/failed_unknown ->\n// KEIN Auto-Resend (unbekannter Zustand) -> 409+Reconciliation; keine Row -> senden.\nconst m=$('Result + TTL (offset-korrekt)').item.json;\nconst rows=$json.result||[];\nif($json.error!==undefined) return [{ json:{ decision:'error' } }];\nif(rows.some(r=>r.state==='sent')) return [{ json:{ decision:'already' } }];\nif(rows.length>0) return [{ json:{ decision:'reconcile' } }];\nreturn [{ json:{ decision:'send', reg_id:m.reg_id, termin:m.termin, email_norm:m.email_norm, name:m.name, unternehmen:m.unternehmen } }];" },
