    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"crm.lead\",\"create\",[{\"name\":\"Infotermin Anmeldung\",\"contact_name\":\"{{ $('Result auspacken + TTL').item.json.name }}\",\"partner_name\":\"{{ $('Result auspacken + TTL').item.json.unternehmen }}\",\"email_from\":\"{{ $('Result auspacken + TTL').item.json.email_norm }}\",\"description\":\"Angemeldet Infoveranstaltung, Termin {{ $('Result auspacken + TTL').item.json.termin }}\"}]] } }",
        "options": {} },
      "id": "wf2-crm-lead", "name": "Odoo create crm.lead (Spiegel, idempotent via Vertriebsregel)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, 560]
    },
    {
      "parameters": { "jsCode": "// ICS in Europe/Berlin per Luxon (host-TZ-unabhängig).\nconst m=$('Result auspacken + TTL').item.json;\nconst start=DateTime.fromISO(m.termin,{setZone:true}).setZone('Europe/Berlin');\nconst end=start.plus({minutes:60});\nconst f=dt=>dt.toFormat(\"yyyyLLdd'T'HHmmss\");\nconst teams=start.day<=29?'{{CONFIG:TEAMS_LINK_T1}}':'{{CONFIG:TEAMS_LINK_T2}}';\nconst ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//manibase//Infotermin//DE','METHOD:REQUEST','BEGIN:VTIMEZONE','TZID:Europe/Berlin','END:VTIMEZONE','BEGIN:VEVENT','UID:'+m.reg_id+'@manibase.de','DTSTAMP:'+DateTime.utc().toFormat(\"yyyyLLdd'T'HHmmss'Z'\"),'SEQUENCE:0','DTSTART;TZID=Europe/Berlin:'+f(start),'DTEND;TZID=Europe/Berlin:'+f(end),'SUMMARY:manibase Infotermin','ORGANIZER:mailto:{{CONFIG:SENDER}}','END:VEVENT','END:VCALENDAR'].join('\\r\\n');\nreturn [{ json:{ ics_base64:Buffer.from(ics).toString('base64'), email_norm:m.email_norm, teams } }];" },
      "id": "wf2-code-ics", "name": "Build ICS (Luxon Europe/Berlin, UID, SEQUENCE, 60min)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2200, 560]
    },
    {
      "parameters": { "method": "POST", "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"message\": { \"subject\": \"Ihre Einladung zum Infotermin\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Einwahl: <a href='{{ $json.teams }}'>Teams</a></p>\" }, \"attachments\": [{ \"@odata.type\": \"#microsoft.graph.fileAttachment\", \"name\": \"termin.ics\", \"contentType\": \"text/calendar\", \"contentBytes\": \"{{ $json.ics_base64 }}\" }], \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $json.email_norm }}\" } }] } }",
        "options": {} },
      "id": "wf2-graph-invite", "name": "Graph sendMail Einladung + ICS", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, 560], "onError": "continueErrorOutput"
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
