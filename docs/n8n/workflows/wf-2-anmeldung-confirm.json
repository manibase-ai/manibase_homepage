      "parameters": { "jsCode": "// Result auspacken + TTL offset-korrekt (Termin-ISO trägt +02:00; create_date ist UTC).\nif($json.error!==undefined) return [{ json:{ outcome:'error' } }];\nconst rows=$json.result||[];\nif(rows.length===0) return [{ json:{ outcome:'not_found' } }];\nconst r=rows[0];\nconst terminMs=Date.parse(r.termin);\nconst createdMs=r.create_date?Date.parse((r.create_date+'').replace(' ','T')+'Z'):0;\nconst expired=(terminMs && terminMs<Date.now()) || (createdMs && (Date.now()-createdMs)/86400000>7);\nif(expired) return [{ json:{ outcome:'expired' } }];\nreturn [{ json:{ outcome:'proceed', reg_id:r.id, status:r.status, termin:r.termin, email_norm:r.email_norm, name:r.name, unternehmen:r.unternehmen } }];" },
