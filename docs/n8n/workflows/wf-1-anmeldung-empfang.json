    "Recovery: reg + doi-outbox lesen": { "main": [[{ "node": "Recovery entscheiden (kein neuer Digest)", "type": "main", "index": 0 }]] },
    "Recovery entscheiden (kein neuer Digest)": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] }
  },
