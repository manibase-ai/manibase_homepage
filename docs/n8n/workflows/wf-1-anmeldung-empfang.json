    { "parameters": { "method": "POST", "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"message\": { \"subject\": \"Bitte bestätigen Sie Ihre Anmeldung\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Bitte bestätigen: <a href='{{CONFIG:BASE_URL}}/api/event-confirm.php?t={{ $('Recovery entscheiden (rotate+resend wenn nicht sent)').item.json.token }}'>Anmeldung bestätigen</a></p>\" }, \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $('Recovery entscheiden (rotate+resend wenn nicht sent)').item.json.email_norm }}\" } }] } }", "options": {} }, "id": "wf1-rec-graph", "name": "Recovery: Graph sendMail DOI (neuer Token)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2520, 500], "onError": "continueErrorOutput" },
    { "parameters": { "respondWith": "json", "responseCode": 200, "responseBody": "={ \"ok\": true }" }, "id": "wf1-resp-200-resend", "name": "Respond 200 (Recovery: neu versandt)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [2740, 420] },
