    { "parameters": { "jsCode": "const crypto=require('crypto');\nconst regRows=$('Recovery: bestehende reg per email+termin lesen').item.json.result||[];\nconst reg_id=regRows[0]?regRows[0].id:null;\nconst rows=$json.result||[];\nconst sent=rows.some(r=>r.state==='sent');\nif(reg_id===null){ return [{ json:{ resend:false, respond502:true } }]; }\nif(sent){ return [{ json:{ resend:false, reg_id } }]; }\n// noch nicht sicher versendet -> neuen Token rotieren + resenden\nconst token=crypto.randomBytes(24).toString('base64url');\nconst token_digest=crypto.createHash('sha256').update(token).digest('hex');\nconst outbox_id=rows.length?rows[0].id:null;\nreturn [{ json:{ resend:true, reg_id, token, token_digest, outbox_id, email_norm:$('Normalize + Token/Digest').item.json.email_norm } }];" }, "id": "wf1-rec-decide", "name": "Recovery entscheiden (rotate+resend wenn nicht sent)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1700, 560] },
