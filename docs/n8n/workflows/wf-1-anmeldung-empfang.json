    { "parameters": { "jsCode": "const crypto=require('crypto');\nconst b=$json.body||{};\nconst email_norm=String(b.email||'').trim().toLowerCase();\nconst token=crypto.randomBytes(24).toString('base64url');\nconst token_digest=crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json: { email_norm, termin:String(b.termin||''), name:String(b.name||''), unternehmen:String(b.unternehmen||''), token, token_digest } }];" }, "id": "wf1-code-token", "name": "Normalize + Token/Digest", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [480, 400] },
