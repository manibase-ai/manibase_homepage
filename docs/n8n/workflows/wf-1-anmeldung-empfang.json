{
  "name": "manibase Infotermin – 1 Anmeldung Empfang",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "manibase-anmeldung", "responseMode": "responseNode", "options": {} },
      "id": "wf1-webhook",
      "name": "Webhook Anmeldung",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 320]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.headers['x-manibase-secret'] }}", "rightValue": "{{CONFIG:SHARED_SECRET}}", "operator": { "type": "string", "operation": "equals" } } ] }
      },
      "id": "wf1-if-secret",
      "name": "IF Secret ok (X-Manibase-Secret)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, 320]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 401, "responseBody": "={ \"ok\": false, \"error\": \"unauthorized\" }" },
      "id": "wf1-resp-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [560, 520]
    },
    {
      "parameters": {
        "jsCode": "// Normalisieren + Token (>=128 bit) + SHA-256-Digest. Termine-Allowlist:\n// {{CONFIG:TERMIN_T1}} / {{CONFIG:TERMIN_T2}}.\nconst crypto = require('crypto');\nconst b = $json.body || {};\nconst email_norm = String(b.email||'').trim().toLowerCase();\nconst termin = String(b.termin||'');\nconst token = crypto.randomBytes(24).toString('base64url');\nconst token_digest = crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json: { email_norm, termin, name: String(b.name||''), unternehmen: String(b.unternehmen||''), token, token_digest } }];"
      },
      "id": "wf1-code-token",
      "name": "Normalize + Token/Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"create\",[{\"email_norm\":\"{{ $json.email_norm }}\",\"termin\":\"{{ $json.termin }}\",\"status\":\"received\",\"token_digest\":\"{{ $json.token_digest }}\"}]] } }",
        "options": {}
      },
      "id": "wf1-odoo-create-reg",
      "name": "Odoo create x_infotermin_reg (unique email_norm+termin)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [760, 320]
    },
    {
      "parameters": {
        "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.error !== undefined }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] }
      },
      "id": "wf1-if-error",
      "name": "IF Odoo error (Unique-Violation?)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 320]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "a1", "name": "reg_id", "value": "={{ $json.result }}", "type": "number" },
          { "id": "a2", "name": "email_norm", "value": "={{ $('Normalize + Token/Digest').item.json.email_norm }}", "type": "string" },
          { "id": "a3", "name": "token", "value": "={{ $('Normalize + Token/Digest').item.json.token }}", "type": "string" }
        ] },
        "options": {}
      },
      "id": "wf1-set-new",
      "name": "Set reg_id + Kontext (Neuanmeldung)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1160, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"create\",[{\"mail_key\":\"doi:{{ $json.reg_id }}\",\"reg_id\":{{ $json.reg_id }},\"state\":\"sending\"}]] } }",
        "options": {}
      },
      "id": "wf1-outbox-doi",
      "name": "Claim outbox mail_key doi (unique)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1360, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"message\": { \"subject\": \"Bitte bestätigen Sie Ihre Anmeldung\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Bitte bestätigen: <a href='{{CONFIG:BASE_URL}}/api/event-confirm.php?t={{ $('Set reg_id + Kontext (Neuanmeldung)').item.json.token }}'>Anmeldung bestätigen</a></p>\" }, \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $('Set reg_id + Kontext (Neuanmeldung)').item.json.email_norm }}\" } }] } }",
        "options": {}
      },
      "id": "wf1-graph-doi",
      "name": "Graph sendMail DOI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 220],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"search\",[[[\"mail_key\",\"=\",\"doi:{{ $('Set reg_id + Kontext (Neuanmeldung)').item.json.reg_id }}\"]]]]] } }",
        "options": {}
      },
      "id": "wf1-outbox-doi-sent",
      "name": "Odoo write outbox doi state=sent (Fehler: failed_unknown)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1760, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{CONFIG:ODOO_URL}}/jsonrpc",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"search_read\",[[[\"email_norm\",\"=\",\"{{ $('Normalize + Token/Digest').item.json.email_norm }}\"],[\"termin\",\"=\",\"{{ $('Normalize + Token/Digest').item.json.termin }}\"]]],{\"fields\":[\"id\",\"token_digest\"]}]] } }",
        "options": {}
      },
      "id": "wf1-recover-find",
      "name": "Recovery: reg + doi-outbox lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1160, 460]
    },
    {
      "parameters": {
        "jsCode": "// Recovery statt Dauersperre: doi-outbox state prüfen (aus vorheriger Suche).\n// state=sent -> idempotent 200 (Digest unverändert). fehlt/sending-alt ->\n// (re)senden bzw. reconcile (state ggf. failed_unknown). Kein neuer Digest.\nconst rows = ($json.result)||[];\nconst reg = rows[0] || {};\nreturn [{ json: { reg_id: reg.id, recovery: true, note: 'reuse stored token_digest; resend nur wenn doi nicht sent' } }];"
      },
      "id": "wf1-recover-decide",
      "name": "Recovery entscheiden (kein neuer Digest)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 460]
    },
    {
      "parameters": { "respondWith": "json", "responseCode": 200, "responseBody": "={ \"ok\": true }" },
      "id": "wf1-resp-200",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1980, 320]
    }
  ],
  "connections": {
    "Webhook Anmeldung": { "main": [[{ "node": "IF Secret ok (X-Manibase-Secret)", "type": "main", "index": 0 }]] },
