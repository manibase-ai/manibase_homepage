      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 340]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.headers['x-manibase-secret'] }}", "rightValue": "{{CONFIG:SHARED_SECRET}}", "operator": { "type": "string", "operation": "equals" } } ] }
      },
      "id": "wf1-if-secret",
      "name": "IF Secret ok (X-Manibase-Secret)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 340]
    },
    { "parameters": { "respondWith": "json", "responseCode": 401, "responseBody": "={ \"ok\": false }" }, "id": "wf1-resp-401", "name": "Respond 401", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [520, 560] },
    {
      "parameters": { "jsCode": "const crypto=require('crypto');\nconst b=$json.body||{};\nconst email_norm=String(b.email||'').trim().toLowerCase();\nconst token=crypto.randomBytes(24).toString('base64url');\nconst token_digest=crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json: { email_norm, termin:String(b.termin||''), name:String(b.name||''), unternehmen:String(b.unternehmen||''), token, token_digest } }];" },
      "id": "wf1-code-token", "name": "Normalize + Token/Digest", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [520, 340]
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"create\",[{\"email_norm\":\"{{ $json.email_norm }}\",\"name\":\"{{ $json.name }}\",\"unternehmen\":\"{{ $json.unternehmen }}\",\"termin\":\"{{ $json.termin }}\",\"status\":\"received\",\"token_digest\":\"{{ $json.token_digest }}\"}]] } }",
        "options": {} },
      "id": "wf1-odoo-create-reg", "name": "Odoo create x_infotermin_reg (unique email_norm+termin, create_date auto)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [740, 340]
    },
    {
      "parameters": { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.error !== undefined }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] } },
      "id": "wf1-if-error", "name": "IF Odoo error?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [940, 340]
    },
    {
      "parameters": { "conditions": { "options": {}, "combinator": "and", "conditions": [ { "leftValue": "={{ /unique|IntegrityError|constraint/i.test(JSON.stringify($json.error||{})) }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] } },
      "id": "wf1-if-unique", "name": "IF Unique-Violation? (sonst techn. Fehler)", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1140, 460]
    },
    { "parameters": { "respondWith": "json", "responseCode": 502, "responseBody": "={ \"ok\": false, \"error\": \"upstream\" }" }, "id": "wf1-resp-502", "name": "Respond 502 (technischer Odoo-Fehler)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [1360, 600] },
    {
      "parameters": { "assignments": { "assignments": [
        { "id": "a1", "name": "reg_id", "value": "={{ $json.result }}", "type": "number" },
        { "id": "a2", "name": "email_norm", "value": "={{ $('Normalize + Token/Digest').item.json.email_norm }}", "type": "string" },
        { "id": "a3", "name": "token", "value": "={{ $('Normalize + Token/Digest').item.json.token }}", "type": "string" }
      ] }, "options": {} },
      "id": "wf1-set-new", "name": "Set reg_id + Kontext (Neuanmeldung)", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1140, 220]
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"create\",[{\"mail_key\":\"doi:{{ $json.reg_id }}\",\"reg_id\":{{ $json.reg_id }},\"state\":\"sending\",\"ts\":\"{{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}\"}]] } }",
        "options": {} },
      "id": "wf1-outbox-doi", "name": "Claim outbox mail_key doi (unique)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1360, 220]
    },
    {
      "parameters": { "method": "POST", "url": "https://graph.microsoft.com/v1.0/users/{{CONFIG:SENDER}}/sendMail", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"message\": { \"subject\": \"Bitte bestätigen Sie Ihre Anmeldung\", \"body\": { \"contentType\": \"HTML\", \"content\": \"<p>Bitte bestätigen: <a href='{{CONFIG:BASE_URL}}/api/event-confirm.php?t={{ $('Set reg_id + Kontext (Neuanmeldung)').item.json.token }}'>Anmeldung bestätigen</a></p>\" }, \"toRecipients\": [{ \"emailAddress\": { \"address\": \"{{ $('Set reg_id + Kontext (Neuanmeldung)').item.json.email_norm }}\" } }] } }",
        "options": {} },
      "id": "wf1-graph-doi", "name": "Graph sendMail DOI", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1580, 220], "onError": "continueErrorOutput"
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"write\",[[{{ $('Claim outbox mail_key doi (unique)').item.json.result }}],{\"state\":\"sent\"}]] } }",
        "options": {} },
      "id": "wf1-outbox-sent", "name": "Odoo write outbox doi state=sent", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1800, 220]
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_outbox\",\"write\",[[{{ $('Claim outbox mail_key doi (unique)').item.json.result }}],{\"state\":\"failed_unknown\"}]] } }",
        "options": {} },
      "id": "wf1-outbox-failed", "name": "Odoo write outbox doi state=failed_unknown", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1800, 380]
    },
    {
      "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"search_read\",[[[\"email_norm\",\"=\",\"{{ $('Normalize + Token/Digest').item.json.email_norm }}\"],[\"termin\",\"=\",\"{{ $('Normalize + Token/Digest').item.json.termin }}\"]]],{\"fields\":[\"id\",\"token_digest\"]}]] } }",
        "options": {} },
      "id": "wf1-recover-find", "name": "Recovery: bestehende reg per email+termin lesen", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1360, 460]
    },
    {
      "parameters": { "jsCode": "// Recovery mit NUTZBAREM Token (kein Dauer-Lockout):\n// Ist noch kein doi-Outbox 'sent' vorhanden (Erstlauf scheiterte vor Versand),\n// wird ein NEUER Token+Digest erzeugt, per write in reg rotiert und die DOI-Mail\n// (re)gesendet; der alte, nie zugestellte Link wird damit ersetzt. War 'sent',\n// idempotent 200 ohne Aktion. Details siehe README (recover-and-rotate).\nconst crypto=require('crypto');\nconst rows=($json.result)||[];\nconst sent=rows.some(r=>r.state==='sent');\nif(sent) return [{ json:{ resend:false } }];\nconst token=crypto.randomBytes(24).toString('base64url');\nconst token_digest=crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json:{ resend:true, token, token_digest } }];" },
      "id": "wf1-recover-decide", "name": "Recovery entscheiden (rotate+resend wenn nicht sent)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1580, 460]
    },
    { "parameters": { "respondWith": "json", "responseCode": 200, "responseBody": "={ \"ok\": true }" }, "id": "wf1-resp-200", "name": "Respond 200", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [2040, 340] }
