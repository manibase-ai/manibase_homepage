    { "parameters": { "method": "POST", "url": "={{CONFIG:ODOO_URL}}/jsonrpc", "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"jsonrpc\":\"2.0\",\"method\":\"call\",\"params\":{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[\"{{CONFIG:ODOO_DB}}\",{{CONFIG:ODOO_UID}},\"{{CONFIG:ODOO_APIKEY}}\",\"x_infotermin_reg\",\"write\",[[{{ $json.reg_id }}],{\"token_digest\":\"{{ $json.token_digest }}\"}]] } }", "options": {} }, "id": "wf1-rec-rotate", "name": "Recovery: reg token_digest rotieren", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2120, 500] },
