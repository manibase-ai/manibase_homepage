# /etc/nginx/sites-available/statistik.manibase.de
# Umami-Dashboard (docs/deployment/statistik-umami.md). Umami lauscht nur auf 127.0.0.1:3005.
server {
    listen 80;
    listen [::]:80;
    server_name statistik.manibase.de;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name statistik.manibase.de;

    ssl_certificate /etc/letsencrypt/live/statistik.manibase.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/statistik.manibase.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Eigene Header statt manibase-security-headers.conf: deren CSP wuerde die Umami-Oberflaeche brechen.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 1m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Erfasst wird nur ueber manibase.de (/u.js, /api/send, gedrosselt); hier sind
    # alle Erfassungswege von Umami 3.4.0 gesperrt, die ohne Anmeldung funktionieren.
    location = /api/send    { return 404; }
    location = /api/batch   { return 404; }
    location = /api/record  { return 404; }
    location = /script.js   { return 404; }
    location = /recorder.js { return 404; }
    location ^~ /p/ { return 404; }
    location ^~ /q/ { return 404; }

    location = /api/auth/login {
        limit_req zone=umami_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3005;
    }

    location / {
        proxy_pass http://127.0.0.1:3005;
    }
}
